# Supabase Configuration
# Get these values from your Supabase project settings at https://app.supabase.com
# IMPORTANT: NEVER commit real credentials - this is just a template!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URL
# Local development (nlg-server running on 8080):
# VITE_BACKEND_URL=http://localhost:8080
# Vercel Production (API functions in api/ directory — same domain):
VITE_BACKEND_URL=/api
# AWS Lambda (alternative, if deployed separately):
# VITE_BACKEND_URL=https://your-lambda-url.on.aws

# Web App URL (used by Flutter WebView modules like Panchang/Festivals)
# Example: https://your-karmank-web-app.vercel.app
VITE_WEB_APP_URL=https://your-karmank-web-app.vercel.app

# Astrology Engine (FastAPI / Swiss Ephemeris backend)
# Set this in Vercel Environment Variables to your deployed FastAPI URL
# Local: leave unset (defaults to http://localhost:8000)
# ASTROLOGY_API_URL=https://your-fastapi-backend.railway.app

# Gemini API Key (set in Vercel Environment Variables, NOT in .env)
# GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================================
# SECURITY — Step 1 (JWT Auth & CORS)
# ============================================================================
# Supabase JWT Secret: Supabase Dashboard → Project Settings → API → JWT Secret
# When set, ALL non-public endpoints require a valid Supabase bearer token.
# Leave unset during initial deployment; add once confirmed working in staging.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Allowed frontend origins (comma-separated, no trailing slash).
# When set, CORS restricts to these origins instead of wildcard *.
# ALLOWED_ORIGINS=https://karmank.in,https://www.karmank.in,https://karmank.vercel.app

# ============================================================================
# SECURITY NOTES:
# ============================================================================
# 1. Copy this file to .env and replace with your actual credentials
# 2. NEVER commit .env files to version control
# 3. Rotate credentials immediately if exposed
# 4. Use environment-specific values (dev vs production)
# 5. Store production secrets in your hosting platform's environment variables
#    - Vercel: Dashboard → Settings → Environment Variables
#    - Netlify: Site settings → Build & deploy → Environment
#    - AWS: Lambda → Configuration → Environment Variables (use Secrets Manager for sensitive data)
